# second-brain-engine 환경설정 예시. 복사해서 .env 로 쓰세요.
#   copy .env.example .env   (Windows)

# 노트 레포(헤르메스가 clone한 my-second-brain) 경로
SB_NOTES_PATH=../my-second-brain
SB_CHROMA_PATH=./chroma_db
SB_COLLECTION_NAME=second_brain

# --- 임베딩 프로바이더 (기본: 로컬 Ollama) ---
SB_EMBEDDING_PROVIDER=ollama
SB_OLLAMA_BASE_URL=http://localhost:11434
SB_OLLAMA_EMBED_MODEL=bge-m3
# 가벼운 대안(영어 위주): nomic-embed-text

# --- OpenAI로 교체하려면 위 provider를 openai로 바꾸고 아래 주석 해제 ---
# SB_EMBEDDING_PROVIDER=openai
# SB_OPENAI_API_KEY=sk-...
# SB_OPENAI_EMBED_MODEL=text-embedding-3-small

# 검색 직전 변경분 자동 재인덱싱
SB_AUTO_SYNC_ON_SEARCH=true
