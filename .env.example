# second-brain-engine 환경설정 예시. 복사해서 .env 로 쓰세요.
#   copy .env.example .env   (Windows)   /   cp .env.example .env   (macOS/Linux)
#
# 이 .env는 MCP 자동 기동에도 쓰인다 — Claude Code(또는 Cursor 등)가 엔진을 자동으로
# 띄울 때 프로젝트 폴더의 .env를 읽어 아래 설정(특히 노트 경로)을 적용한다.

# 노트 폴더(뇌) 경로 — 엔진이 읽고/쓰는 마크다운 노트 위치.
# 처음이라면 번들 샘플로 시작해 보세요:  SB_NOTES_PATH=examples/vault
SB_NOTES_PATH=../my-second-brain
SB_CHROMA_PATH=./chroma_db
SB_COLLECTION_NAME=second_brain

# --- 임베딩 백엔드 (교체형) ---
# provider: ollama | lmstudio | llamacpp | tei | openai | voyage | gemini
# embed_model / base_url 비우면 provider 프리셋 기본값. 클라우드는 api_key 필요.
SB_EMBEDDING_PROVIDER=ollama
SB_EMBED_MODEL=
SB_EMBED_BASE_URL=
SB_EMBED_API_KEY=

# 전환 예시:
#   Gemini    : SB_EMBEDDING_PROVIDER=gemini   + SB_EMBED_API_KEY=AIza...
#   OpenAI    : SB_EMBEDDING_PROVIDER=openai   + SB_EMBED_API_KEY=sk-...
#   Voyage    : SB_EMBEDDING_PROVIDER=voyage   + SB_EMBED_API_KEY=pa-...
#   LM Studio : SB_EMBEDDING_PROVIDER=lmstudio + SB_EMBED_MODEL=<로드한 모델명>
#   llama.cpp : SB_EMBEDDING_PROVIDER=llamacpp + SB_EMBED_MODEL=<서버 모델>

# 검색 직전 변경분 자동 재인덱싱
SB_AUTO_SYNC_ON_SEARCH=true
